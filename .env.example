# Copy to .env and edit. Only APP_URL matters for a first run.

# Public URL people open. Used in emailed links and reminders, and turns on Secure cookies when https.
# Required when SMTP is set: emails are not sent without it.
APP_URL=http://localhost:3000

# The first account can always sign up. Set true to let more people create accounts.
ALLOW_SIGNUP=false

# Set true when running behind a reverse proxy so audit logs and rate limits use the client IP from X-Forwarded-For.
TRUST_PROXY=false

# Optional email. Without SMTP_HOST, copy signing links from the document page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Countersign <sign@example.com>"

# AES-256-GCM key for documents and field values at rest: 32 bytes as 64 hex characters or base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is created at DATA_DIR/encryption.key, beside the data it protects (weak protection).
# Losing the key loses every document. Back it up separately from the data volume. Never change it once set.
ENCRYPTION_KEY=

# Optional certificate for the digital seal on completed PDFs: a PKCS#12 (.p12/.pfx) file as base64, and its passphrase.
# Generate the value: base64 -w0 seal.p12   (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('seal.p12')))
# If unset, a self-signed seal certificate is created once at DATA_DIR/signing.p12 (encrypted with ENCRYPTION_KEY).
# A self-signed seal shows whether the PDF changed after completion; it does not identify your organisation.
SIGNING_P12_BASE64=
SIGNING_P12_PASSPHRASE=

# Security controls (defaults shown).
# Signing links expire this many days after they are sent; a reminder extends them.
TOKEN_TTL_DAYS=30
# Sessions end after this many minutes without activity, and SESSION_MAX_DAYS after sign-in regardless.
SESSION_IDLE_MINUTES=60
SESSION_MAX_DAYS=7
# Failed sign-ins for one account from one IP per 15 minutes before that account+IP pair is locked for 15 minutes.
# Failures from other IPs never lock the account; past 10 failures an hour they only slow each attempt (up to 5 s).
LOGIN_MAX_ATTEMPTS=5
# Failed sign-ins from one IP (all accounts) per 15 minutes before that IP is locked for 15 minutes.
# Accounts that signed in successfully from that IP in the last 30 days are not affected.
LOGIN_IP_MAX_ATTEMPTS=50
# Sign-up attempts per IP per hour.
SIGNUP_MAX_PER_HOUR=10
# IMPORTANT behind a reverse proxy: set TRUST_PROXY=true (above), or every client shares the proxy's IP
# and one attacker can trip the per-IP limits for everyone. Leave it false when clients connect directly,
# otherwise they can forge X-Forwarded-For to dodge the limits.
